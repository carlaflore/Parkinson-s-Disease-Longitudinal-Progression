```{r setup, include=FALSE}
knitr::opts_chunk$set(echo = TRUE)
install.packages(c("dplyr", "ggplot2", "lme4", "nlme", "survival", "JM"))
library(dplyr)    # For data manipulation
library(ggplot2)  # For plotting
library(lme4)     # For Linear Mixed Models
library(nlme)     # Alternative for Mixed Models (needed for JM)
library(survival) # For dropout survival analysis
library(JM)       # For Shared Parameter MNAR models (Slide 442)

load("/Users/claradomning/Downloads/Group_11.RData")
View(DF)
str(DF)
DF$sex <- as.factor(DF$sex)
DF$smoking_status <- as.factor(DF$smoking_status)

DF <- DF %>%
arrange(id, Visit)

#sequence of visits 
patient_summary <- DF %>%
group_by(id) %>%
summarise(total_visits = n(),last_seen = max(Visit, na.rm = TRUE),
#Classify missing data
pattern = case_when(total_visits == 8 ~ "Completer", total_visits < (last_seen + 1) ~ "Intermittent", total_visits == (last_seen + 1) & last_seen < 7 ~ "Dropout"),

dropped_out_binary = ifelse(total_visits < 8, 1, 0))    

# Merge to main dataset
DF <- left_join(DF, patient_summary, by = "id")
#category
table(patient_summary$pattern)

#MAR?
baseline_data <- DF %>%
filter(Visit == 0)
names(baseline_data)

#AGE
t.test(Age ~ pattern, data = baseline_data)

#BASELINE UPDRS
t.test(UPDRS ~ pattern, data = baseline_data)

#SEX
chisq.test(table(baseline_data$sex, baseline_data$pattern))

# SMOKING
chisq.test(table(baseline_data$smoking_status, baseline_data$pattern))
```
