```{r setup, include=FALSE}
knitr::opts_chunk$set(echo = TRUE)
install.packages(c("dplyr", "ggplot2", "lme4", "nlme", "survival", "JM"))
library(dplyr)    # For data manipulation
library(ggplot2)  # For plotting
library(lme4)     # For Linear Mixed Models
library(nlme)     # Alternative for Mixed Models (needed for JM)
library(survival) # For dropout survival analysis
library(JM)       # For Shared Parameter MNAR models (Slide 442)

load("/Users/claradomning/Downloads/Group_11.RData")
View(DF)
str(DF)
DF$sex <- as.factor(DF$sex)
DF$smoking_status <- as.factor(DF$smoking_status)

DF <- DF %>%
arrange(id, Visit)

#sequence of visits 
patient_summary <- DF %>%
group_by(id) %>%
summarise(total_visits = n(),last_seen = max(Visit, na.rm = TRUE),
#Classify missing data
pattern = case_when(total_visits == 8 ~ "Completer", total_visits < (last_seen + 1) ~ "Intermittent", total_visits == (last_seen + 1) & last_seen < 7 ~ "Dropout"),

dropped_out_binary = ifelse(total_visits < 8, 1, 0))    

# Merge to main dataset
DF <- left_join(DF, patient_summary, by = "id")
#category
table(patient_summary$pattern)

#MAR?
baseline_data <- DF %>%
filter(Visit == 0)
names(baseline_data)

#AGE
t.test(Age ~ pattern, data = baseline_data)

#BASELINE UPDRS
t.test(UPDRS ~ pattern, data = baseline_data)

#SEX
chisq.test(table(baseline_data$sex, baseline_data$pattern))

# SMOKING
chisq.test(table(baseline_data$smoking_status, baseline_data$pattern))

library(dplyr)
#Summary Missing
visit_summary <- DF %>%
group_by(Visit) %>%
summarise(patients_present = n()) %>% mutate( patients_missing = 500 - patients_present, percent_missing = round((patients_missing / 500) * 100, 1))
visit_summary$more_than_5_percent <- ifelse(visit_summary$percent_missing > 5, "Yes", "No")
# Print the table
print(visit_summary)


#ONLY Dropout 
dropout_baseline <- DF %>%
filter(pattern == "Dropout" & Visit == 0)

#AGE 
print("--- AGE OF DROPOUTS ---")
summary(dropout_baseline$Age)

#BASELINE UPDRS
print("--- STARTING UPDRS OF DROPOUTS ---")
summary(dropout_baseline$UPDRS)

#SEX
print("--- SEX OF DROPOUTS ---")
table(dropout_baseline$sex)

#SMOKING
print("--- SMOKING STATUS OF DROPOUTS ---")
table(dropout_baseline$smoking_status)

#first score dropout 
start_scores <- DF %>%
filter(pattern == "Dropout" & Visit == 0) %>%
dplyr::select(id, UPDRS_start = UPDRS)

#last score individual 
final_scores <- DF %>%
filter(pattern == "Dropout" & Visit == last_seen & last_seen > 0) %>%
dplyr::select(id, UPDRS_final = UPDRS)

#trend t-test of both
dropout_change <- inner_join(start_scores, final_scores, by = "id")
t.test(dropout_change$UPDRS_final, dropout_change$UPDRS_start, paired = TRUE)

library(dplyr)

#Why dropout? other varaiables 
baseline_data <- DF %>%
filter(Visit == 0) %>%
mutate(is_dropout = ifelse(pattern == "Dropout", 1, 0))

#GLM
dropout_model <- glm(is_dropout ~ Age + sex + smoking_status + UPDRS, 
data = baseline_data, 
family = "binomial")

summary(dropout_model)

library(ggplot2)
library(dplyr)

#only dropout
dropout_data <- DF %>%
filter(pattern == "Dropout")

#Spaghetti Plot 
ggplot(dropout_data, aes(x = Visit, y = UPDRS, group = id)) +
#visits blue
geom_line(color = "dodgerblue", alpha = 0.7, linewidth = 1) + 
  
#black dots for the actual visits 
geom_point(color = "black", size = 2) +
  
theme_minimal() +
labs(title = "Spaghetti Plot: UPDRS Dropouts",
x = "Visit Number (0 to 7)",
y = "UPDRS Score") +
scale_x_continuous(breaks = 0:7)
